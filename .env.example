# Documentation only. Never commit a filled environment file.
# CLI programs read process environment; this file is not automatically loaded.

# GitHub Actions Secrets (the user's private data repository)
STEAMID64=
STEAM_REFRESH_TOKEN=
# Optional Leetify enrichment; not the Demo download login.
LEETIFY_API_KEY=
# Keep optional Leetify calls out of a local Demo-only setup.
CS2_SKIP_LEETIFY=true
# Recommended all-or-none for official sharing-code cursor discovery:
STEAM_WEB_API_KEY=
STEAM_MATCH_AUTH_CODE=
STEAM_KNOWNCODE=

# Optional local one-shot Demo download; no long-lived credentials in URL.
CS2_DEMO_URL=
CS2_DEMO_SHARE_CODE=
# Exact additional trusted HTTPS hosts, comma-separated; default Valve hosts work without this.
CS2_DEMO_ALLOWED_HOSTS=

# Sites runtime secrets, set in the user's own project secret manager:
# GitHub fine-grained token scoped only to the user's private data repository.
GITHUB_ACTIONS_TOKEN=
# Optional website coach. MCP data tools do not require this.
DEEPSEEK_API_KEY=
